{
  "name": "pipetic/salesforce",
  "type": "library",
  "license": "MIT",
  "description": "Salesforce adapter for the Pipetic platform. Provides OAuth 2.0 authentication and ETL data sync for multi-tenant SaaS applications.",
  "keywords": [
    "salesforce",
    "oauth2",
    "etl",
    "crm",
    "pipetic",
    "integration",
    "adapter"
  ],
  "homepage": "https://github.com/pipetic/salesforce",
  "authors": [
    {
      "name": "Gabriel Solomon",
      "email": "hello@gabrielsolomon.ro"
    }
  ],
  "autoload": {
    "psr-4": {
      "Pipetic\\Salesforce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pipetic\\Salesforce\\Tests\\": "tests/src",
      "Pipetic\\Salesforce\\Tests\\Fixtures\\": "tests/fixtures"
    }
  },
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "pipetic/bundle": "dev-main",
    "bytic/rest-client": "dev-master|dev-develop|^1.0",
    "stevenmaguire/oauth2-salesforce": "^2.0"
  },
  "require-dev": {
    "bytic/phpqatools": "^1.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "ergebnis/composer-normalize": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "bytic/phpqatools": true,
      "php-http/discovery": true
    }
  }
}

